{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TfStateList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": ["arn:aws:s3:::verrify-terraform-state-develop","arn:aws:s3:::faber-terraform-state-production"]
    },
    {
      "Sid": "TfStateRW",
      "Effect": "Allow",
      "Action": ["s3:GetObject","s3:PutObject"],
      "Resource": ["arn:aws:s3:::verrify-terraform-state-develop/heatmap-japan/*","arn:aws:s3:::faber-terraform-state-production/heatmap-japan/*"]
    },
    {
      "Sid": "TfStateLock",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-1:*:table/verify-terraform-lock"
    },
    {
      "Sid": "TfStateKmsIfSseKms",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Condition": {"StringEquals":{"kms:ViaService":"s3.ap-northeast-1.amazonaws.com"}}
    },
    {
      "Sid": "ReadOnlyGlobal",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "elasticache:Describe*",
        "elasticache:ListTagsForResource",
        "ecs:DescribeTaskDefinition",
        "elasticloadbalancing:Describe*",
        "application-autoscaling:Describe*",
        "application-autoscaling:ListTagsForResource",
        "cloudwatch:DescribeAlarms",
        "logs:DescribeLogGroups",
        "ecr:GetAuthorizationToken",
        "states:ListStateMachines",
        "states:ValidateStateMachineDefinition"
      ],
      "Resource": "*",
      "Condition": {"StringEquals":{"aws:RequestedRegion":["ap-northeast-1","us-east-1"]}}
    },
    {
      "Sid": "IamRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:DetachRolePolicy",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::*:role/heatmap-*"
    },
    {
      "Sid": "IamAttachOnlyKnownPolicies",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::*:role/heatmap-*",
      "Condition": {"ArnLike":{"iam:PolicyARN":["arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole","arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy","arn:aws:iam::*:policy/heatmap-*"]}}
    },
    {
      "Sid": "IamManagedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:*PolicyVersion*",
        "iam:TagPolicy",
        "iam:UntagPolicy",
        "iam:ListPolicyTags"
      ],
      "Resource": "arn:aws:iam::*:policy/heatmap-*"
    },
    {
      "Sid": "IamPassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/heatmap-*",
      "Condition": {"StringEquals":{"iam:PassedToService":["lambda.amazonaws.com","states.amazonaws.com","scheduler.amazonaws.com","ecs-tasks.amazonaws.com"]}}
    },
    {
      "Sid": "IamServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {"StringEquals":{"iam:AWSServiceName":["ecs.amazonaws.com","ecs.application-autoscaling.amazonaws.com","elasticache.amazonaws.com","elasticloadbalancing.amazonaws.com"]}}
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:UpdateFunctionConfiguration",
        "lambda:Get*",
        "lambda:List*",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:DeleteAlias",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:PublishVersion"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:*:function:MonthlyAddingSiteTablesProducer*",
        "arn:aws:lambda:ap-northeast-1:*:function:MonthlyAddingSiteTablesConsumer*",
        "arn:aws:lambda:ap-northeast-1:*:function:DeleteHeatMapCache*",
        "arn:aws:lambda:ap-northeast-1:*:function:DeleteOldDataHeatMap*",
        "arn:aws:lambda:ap-northeast-1:*:function:CheckLimit*",
        "arn:aws:lambda:ap-northeast-1:*:function:MonthlyResetLimit*",
        "arn:aws:lambda:ap-northeast-1:*:function:AutoDeleteSiteHeatMap*",
        "arn:aws:lambda:ap-northeast-1:*:function:MoveDataToMysql*",
        "arn:aws:lambda:ap-northeast-1:*:function:daily-inactive-request-update*"
      ]
    },
    {
      "Sid": "Ec2CreateSgInKnownVpcs",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": ["arn:aws:ec2:ap-northeast-1:*:vpc/vpc-0e73fb9db193eef69"]
    },
    {
      "Sid": "Ec2SecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroup*",
        "ec2:RevokeSecurityGroup*",
        "ec2:UpdateSecurityGroupRuleDescriptions*",
        "ec2:ModifySecurityGroupRules",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": ["arn:aws:ec2:ap-northeast-1:*:security-group/*","arn:aws:ec2:ap-northeast-1:*:security-group-rule/*"]
    },
    {
      "Sid": "Ec2LambdaEniCleanupOnSgDelete",
      "Effect": "Allow",
      "Action": ["ec2:DetachNetworkInterface","ec2:DeleteNetworkInterface"],
      "Resource": "arn:aws:ec2:ap-northeast-1:*:network-interface/*"
    },
    {
      "Sid": "ElastiCache",
      "Effect": "Allow",
      "Action": [
        "elasticache:*ReplicationGroup",
        "elasticache:*ReplicaCount",
        "elasticache:*CacheSubnetGroup",
        "elasticache:*CacheParameterGroup",
        "elasticache:AddTagsToResource",
        "elasticache:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:elasticache:ap-northeast-1:*:replicationgroup:heatmap-japan-valkey*",
        "arn:aws:elasticache:ap-northeast-1:*:cluster:heatmap-japan-valkey*",
        "arn:aws:elasticache:ap-northeast-1:*:subnetgroup:heatmap-japan-valkey*",
        "arn:aws:elasticache:ap-northeast-1:*:parametergroup:heatmap-japan-valkey*",
        "arn:aws:elasticache:ap-northeast-1:*:parametergroup:default.valkey*"
      ]
    },
    {
      "Sid": "LogsDeliveryForElastiCacheSlowLog",
      "Effect": "Allow",
      "Action": [
        "logs:*LogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutResourcePolicy",
        "logs:DescribeResourcePolicies"
      ],
      "Resource": "*",
      "Condition": {"StringEquals":{"aws:RequestedRegion":"ap-northeast-1"}}
    },
    {
      "Sid": "LogGroupsAndMetricFilters",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:*RetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:ListTagsLogGroup",
        "logs:*MetricFilter*"
      ],
      "Resource": [
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/lambda/*",
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/elasticache/valkey/heatmap-japan-valkey*",
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/ecs/containerinsights/heatmap-japan-cluster/*",
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/ecs/service/heatmap-*",
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/ecs/task/heatmap-*"
      ]
    },
    {
      "Sid": "CloudWatchAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:cloudwatch:ap-northeast-1:*:alarm:Heatmap*",
        "arn:aws:cloudwatch:ap-northeast-1:*:alarm:heatmap-*",
        "arn:aws:cloudwatch:ap-northeast-1:*:alarm:TargetTracking-service/heatmap-japan-cluster/*",
        "arn:aws:cloudwatch:us-east-1:*:alarm:Heatmap-Route53HealthCheck-*"
      ]
    },
    {
      "Sid": "Sns",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:*TopicAttributes",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:*SubscriptionAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource"
      ],
      "Resource": ["arn:aws:sns:ap-northeast-1:*:monthly-adding-site-tables-notifications*","arn:aws:sns:us-east-1:*:heatmap-dev-route53-alarm-email-test*"]
    },
    {
      "Sid": "Scheduler",
      "Effect": "Allow",
      "Action": ["scheduler:*Schedule"],
      "Resource": "arn:aws:scheduler:ap-northeast-1:*:schedule/default/heatmap-japan-*"
    },
    {
      "Sid": "StepFunctions",
      "Effect": "Allow",
      "Action": [
        "states:CreateStateMachine",
        "states:DescribeStateMachine",
        "states:UpdateStateMachine",
        "states:DeleteStateMachine",
        "states:ListStateMachineVersions",
        "states:TagResource",
        "states:UntagResource",
        "states:ListTagsForResource"
      ],
      "Resource": "arn:aws:states:ap-northeast-1:*:stateMachine:monthly-adding-site-tables-consumer*"
    },
    {
      "Sid": "Ecr",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeRepositories",
        "ecr:PutImageScanningConfiguration",
        "ecr:PutImageTagMutability",
        "ecr:*LifecyclePolicy",
        "ecr:TagResource",
        "ecr:UntagResource",
        "ecr:ListTagsForResource",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:ap-northeast-1:*:repository/heatmap-*"
    },
    {
      "Sid": "Ecs",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:UpdateCluster",
        "ecs:UpdateClusterSettings",
        "ecs:PutClusterCapacityProviders",
        "ecs:DeleteCluster",
        "ecs:DescribeClusters",
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:DescribeServices",
        "ecs:RegisterTaskDefinition",
        "ecs:TagResource",
        "ecs:UntagResource",
        "ecs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ecs:ap-northeast-1:*:cluster/heatmap-japan-cluster",
        "arn:aws:ecs:ap-northeast-1:*:service/heatmap-japan-cluster/*",
        "arn:aws:ecs:ap-northeast-1:*:task-definition/heatmap-*"
      ]
    },
    {
      "Sid": "EcsAutoScaling",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:*ScalableTarget",
        "application-autoscaling:*ScalingPolicy",
        "application-autoscaling:TagResource",
        "application-autoscaling:UntagResource"
      ],
      "Resource": "*",
      "Condition": {"StringEquals":{"application-autoscaling:service-namespace":"ecs"}}
    },
    {
      "Sid": "AlbWrite",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:Create*",
        "elasticloadbalancing:Delete*",
        "elasticloadbalancing:Modify*",
        "elasticloadbalancing:Set*",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-northeast-1:*:loadbalancer/app/heatmap-*/*",
        "arn:aws:elasticloadbalancing:ap-northeast-1:*:targetgroup/heatmap-*/*",
        "arn:aws:elasticloadbalancing:ap-northeast-1:*:listener/app/heatmap-*/*"
      ]
    },
    {
      "Sid": "Route53HealthCheckCreate",
      "Effect": "Allow",
      "Action": "route53:CreateHealthCheck",
      "Resource": "*"
    },
    {
      "Sid": "Route53HealthCheck",
      "Effect": "Allow",
      "Action": [
        "route53:GetHealthCheck",
        "route53:UpdateHealthCheck",
        "route53:DeleteHealthCheck",
        "route53:ChangeTagsForResource",
        "route53:ListTagsForResource"
      ],
      "Resource": "arn:aws:route53:::healthcheck/*"
    }
  ]
}
